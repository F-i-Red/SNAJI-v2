# SNAJI — Variáveis de ambiente
# Copia para .env e preenche os valores reais
# NUNCA commites o .env para Git

# LLM — obrigatório
ANTHROPIC_API_KEY=sk-ant-...

# JWT — gera com: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=gera-um-secret-longo-aqui

# Base de dados PostgreSQL
DATABASE_URL=postgresql://snaji:password@localhost:5432/snaji_db

# Redis (para filas e cache)
REDIS_URL=redis://localhost:6379/0

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,https://snaji.gov.pt

# Ambiente
DEBUG=false
LOG_LEVEL=INFO
ANTHROPIC_MODEL=claude-sonnet-5

# ── Recuperação de normas ───────────────────────────────────────────────
# Reescrita da pergunta em linguagem jurídica pela LLM, antes da pesquisa.
# É o que permite que "estou despedida" encontre "cessação do contrato de
# trabalho". Custa uma chamada curta por análise. Desactivar com 0.
SNAJI_REESCRITA=1

# Recuperação semântica (embeddings) — DESACTIVADA por omissão.
# Medição interna (top-15, com reescrita jurídica): BM25 sozinho obtém 68% de
# cobertura das normas de referência; com embeddings desce para 55%. O modelo
# pequeno multilingue não distingue bem terminologia jurídica portuguesa.
# Para experimentar: instalar sentence-transformers e pôr 1 abaixo.
SNAJI_EMBEDDINGS=0
SNAJI_MODELO_EMBEDDING=intfloat/multilingual-e5-small
# Alternativa maior e melhor (~1,1 GB, recálculo mais demorado):
# SNAJI_MODELO_EMBEDDING=intfloat/multilingual-e5-base

# Peso do BM25 na fusão híbrida: 1.0 = só palavras, 0.0 = só significado.
# 0.9 é o valor medido como óptimo (com reescrita jurídica activa)
# (ferramentas/afinar_recuperacao.py). Reavaliar se mudar de modelo.
SNAJI_PESO_BM25=0.9

# Caracteres de cada artigo usados no vector semântico (0 = texto completo).
# Alterar este valor invalida a cache e obriga a recalcular os vectores.
SNAJI_EMB_MAX_CARACTERES=700

# Reescritas independentes cujas pesquisas são combinadas por consenso.
# Um artigo encontrado por várias reescritas é mais provavelmente relevante.
# Medido: melhor reescrita isolada 77%, consenso de três 95%.
# Custa N chamadas curtas por análise (só na primeira vez: fica em cache).
# 1 desactiva o consenso.
SNAJI_N_REESCRITAS=3
